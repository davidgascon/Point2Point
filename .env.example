# Copy to .env and fill in before the first `docker compose up`.

# The domain this is served from. Must already point at this VM public IP
# (an A record) before you start, or Caddy cannot get a certificate.
APP_DOMAIN=checkout.example.com

# Where Let us Encrypt sends expiry warnings.
TLS_EMAIL=you@example.com

# Pin the backend. Check https://github.com/pocketbase/pocketbase/releases
# and bump deliberately - this project is pre-1.0 and its API still moves.
PB_VERSION=0.29.3
