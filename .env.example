# Copy to .env. Created for you by ./setup.sh.

# Host port your Nginx Proxy Manager forwards to.
APP_PORT=8080

# The public URL NPM serves this on. Used in password-reset emails,
# so get it right or the links point at the wrong place.
PUBLIC_URL=https://checkout.example.com

# Pin the backend. PocketBase is pre-1.0; bump deliberately.
PB_VERSION=0.29.3
